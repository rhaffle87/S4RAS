# ========================================================
# S4RAS Monitor (Prometheus, Grafana, Alertmanager) Config
# Node: VM 204 (s4ras-monitor)
# ========================================================

# Grafana Master Admin Password
GRAFANA_ADMIN_PASSWORD=change_this_to_secure_grafana_admin_password

# Grafana OIDC SSO Integration
GRAFANA_OIDC_CLIENT_SECRET=change_this_to_keycloak_grafana_secret

# Alertmanager Webhook Token (Matches VM 208 PORTAL ALERTMANAGER_SECRET)
ALERT_WEBHOOK_TOKEN=change_this_to_matched_alertmanager_secret_from_vm208

# Telegram Bot Alerting Configuration
TELEGRAM_BOT_TOKEN=change_this_to_telegram_bot_token
TELEGRAM_CHAT_ID=change_this_to_telegram_chat_id
