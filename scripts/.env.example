# ==============================================================================
# S4RAS OPS & AUTOMATION SCRIPTS CONFIGURATION TEMPLATE (.env.example)
# Architecture: Variable-Based Injection (No Hardcoded Credentials)
# ==============================================================================

# SSH authentication for automation scripts
S4RAS_SSH_KEY=~/.ssh/id_ed25519
S4RAS_SSH_PASS=your-cluster-ssh-passphrase-here

# Database backup & disaster recovery credentials
MOODLE_DB_PASSWORD=your-moodle-db-password-here
MYSQL_ROOT_PASSWORD=your-mysql-root-password-here
NC_BACKUP_PASSWORD=your-nextcloud-backup-password-here

# Webhook notification secret
S4RAS_WEBHOOK_SECRET=your-webhook-event-secret-here
