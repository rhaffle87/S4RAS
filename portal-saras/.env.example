# ==============================================================================
# S4RAS PORTAL BFF & FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Architecture: Fail-Closed Security Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE RUNTIME & HTTP SERVER
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. FAIL-CLOSED API TOKENS & WEBHOOK SECRETS (MANDATORY IN PRODUCTION)
# If unset, protected endpoints return 503 Service Unavailable / 401 Unauthorized
# ------------------------------------------------------------------------------
# Keycloak Realm RSA Public Key for cryptographic JWT signature verification (fail-closed)
KEYCLOAK_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
KEYCLOAK_JWKS_URL=https://sso.s4ras.site/realms/S4RAS/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://sso.s4ras.site/realms/S4RAS
KEYCLOAK_ALLOWED_CLIENTS=front-end,saras-portal,account,broker,admin-cli,moodle,nextcloud,jellyfin
JWT_SECRET=your-jwt-shared-secret-here

# Token for triggering zero-downtime rolling builds (/api/deploy)
DEPLOY_TOKEN=your-random-deploy-token-here

# Secret for Cluster Event Mesh webhook publisher (/api/webhooks/event)
CLUSTER_EVENT_SECRET=your-cluster-event-mesh-secret-here

# Secret for Prometheus Alertmanager webhook ingress (/api/alerts)
ALERTMANAGER_SECRET=your-alertmanager-webhook-secret-here

# Token for posting system-wide announcements (/api/announcements)
ADMIN_TOKEN=your-admin-announcement-token-here

# ------------------------------------------------------------------------------
# 3. WEBRTC, STUN/TURN & PJSIP TELEPHONY CREDENTIALS
# Handed to authenticated clients via GET /api/me/context (Bearer JWT required)
# ------------------------------------------------------------------------------
STUN_URL=stun:192.168.10.202:3478
TURN_URL=turn:192.168.10.202:3478
TURN_USERNAME=s4ras
TURN_CREDENTIAL=your-coturn-shared-secret-here

SIP_WS_SERVER=wss://voip.s4ras.site/ws
SIP_REALM=s4ras.site

# Extension SIP Secrets (mapped by extension number or username)
SIP_SECRETS_JSON={"1001":"your-sip-secret-for-1001","1002":"your-sip-secret-for-1002","1003":"your-sip-secret-for-1003"}
SIP_SECRET_1001=your-sip-secret-for-1001
SIP_SECRET_1002=your-sip-secret-for-1002
SIP_SECRET_1003=your-sip-secret-for-1003
SIP_SECRET_1074700=your-sip-secret-for-admin-1074700
SIP_SECRET_1079348=your-sip-secret-for-fellow-1079348

# Username aliases
SIP_SECRET_STUDENT1=your-sip-secret-for-1001
SIP_SECRET_TEACHER1=your-sip-secret-for-1002
SIP_SECRET_DEV1=your-sip-secret-for-1003
SIP_SECRET_ADMIN=your-sip-secret-for-admin-1074700
SIP_SECRET_TESTUSER=your-sip-secret-for-fellow-1079348

# ------------------------------------------------------------------------------
# 4. REDIS IN-MEMORY CACHE & EVENT MESH (OPTIONAL)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT BUILD CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
REACT_APP_KEYCLOAK_URL=https://sso.s4ras.site
REACT_APP_KEYCLOAK_REALM=s4ras
REACT_APP_KEYCLOAK_CLIENT_ID=front-end
REACT_APP_BACKEND_API_URL=/api
