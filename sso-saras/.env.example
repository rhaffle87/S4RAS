# ========================================================
# S4RAS SSO (Keycloak Identity & Access Management) Config
# Node: VM 206 (s4ras-sso)
# ========================================================

# PostgreSQL Database Credentials
KEYCLOAK_DB_PASSWORD=change_this_to_secure_keycloak_db_password

# Keycloak Master Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_to_secure_keycloak_admin_password

# Hostname & Realm Settings
KC_HOSTNAME=sso.s4ras.site
KC_HTTP_PORT=8080
