# MariaDB Root & Application Passwords
MYSQL_ROOT_PASSWORD=change_this_to_secure_mariadb_root_password
MYSQL_PASSWORD=change_this_to_secure_nextcloud_db_password

# Nextcloud Master Administrator
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_this_to_secure_nextcloud_admin_password

# Collabora Online (CODE) Credentials
COLLABORA_ADMIN_PASSWORD=change_this_to_secure_collabora_admin_password
