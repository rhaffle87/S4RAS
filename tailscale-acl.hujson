// Tailscale Access Control Lists (ACLs) - Uncapped Full Access for S4RAS Team
{
	"tagOwners": {
		"tag:s4ras-vm": ["autogroup:admin", "autogroup:members"]
	},

	// Uncapped packet filtering: any node/user can access any destination port
	"acls": [
		{
			"action": "accept",
			"src": ["*"],
			"dst": ["*:*"]
		}
	],

	// Uncapped SSH: all members can SSH into cluster VMs as root, s4ras, or nonroot
	"ssh": [
		{
			"action": "accept",
			"src": ["autogroup:members"],
			"dst": ["tag:s4ras-vm", "autogroup:self"],
			"users": ["root", "s4ras", "autogroup:nonroot"]
		}
	],

	// Auto-approve subnet routes advertised by cluster VMs
	"autoApprovers": {
		"routes": {
			"192.168.10.0/24": ["tag:s4ras-vm"]
		}
	}
}
